        "adapter": "connector_api",
        "outcome": "success",
        "result_empty": true,
        "enumeration_complete": false,
        "evidence_id": "e-empty-context",
        "direction": "context",
        "pointer": "connector://profiles/list",
        "lineage_id": "connector-read:profiles-list",
        "source_identity": "provider profile enumeration",
        "authority": "primary",
        "specificity": "exact",
        "freshness": "current",
        "provenance": {"quality": "verified", "provider_execution": "read_executed"},
        "limitations": []
      },
      "expect_evidence": true,
      "expected_source_class": "connector_or_api",
      "expected_evidence_limitations": [
        "empty result does not prove absence because enumeration completeness is unverified"
      ]
    },
    {
      "name": "exhaustive empty connector read may directly support scoped absence",
      "observation": {
